# GEMINI_API_KEY: Gemini API Key for market analysis
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# FINNHUB_API_KEY: Finnhub API Key for fetching NVIDIA news
FINNHUB_API_KEY="YOUR_FINNHUB_API_KEY"

# DISCORD_WEBHOOK_URL: Webhook URL of your Discord channel
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# GEMINI_MODEL: Optional Gemini model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

